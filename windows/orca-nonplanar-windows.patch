index 03ddaf8f..63f3006b 100644
--- a/src/libslic3r/NonplanarSurface.cpp
+++ b/src/libslic3r/NonplanarSurface.cpp
@@ -2,6 +2,10 @@
 #include "Exception.hpp"
 
 #include <cstdio>
+#include <iostream>
+#include <map>
+#include <utility>
+#include <vector>
 #include <boost/log/trivial.hpp>
 
 namespace Slic3r {
@@ -178,13 +182,22 @@ NonplanarSurface::group_surfaces()
 void
 NonplanarSurface::mark_neighbor_surfaces(int id)
 {
-    //if already marked return
-    if(this->mesh.find(id) == this->mesh.end() || this->mesh[id].marked == true) return;
-    //mark this facet
-    this->mesh[id].marked = true;
-    //mark all neighbors
-    for(int j = 0; j < 3; j++) {
-        this->mark_neighbor_surfaces(this->mesh[id].neighbor[j]);
+    // Explicit stack instead of recursion: the depth grows with the facet count
+    // of a connected surface, which overflows the 1 MB main thread stack of
+    // Windows (the CLI and the unit tests slice there) on dense meshes.
+    std::vector<int> pending { id };
+    while (! pending.empty()) {
+        const int current = pending.back();
+        pending.pop_back();
+        //if already marked continue
+        auto facet = this->mesh.find(current);
+        if (facet == this->mesh.end() || facet->second.marked)
+            continue;
+        //mark this facet
+        facet->second.marked = true;
+        //mark all neighbors
+        for (int j = 0; j < 3; j++)
+            pending.push_back(facet->second.neighbor[j]);
     }
 }
 
